# ============================================================
# Contract-Scenario-Scorer 配置示例
# 复制为 backend/.env 后填入真实值；.env 已被 .gitignore 忽略
# ============================================================

# 默认评分后端：本地 Qwen；如需 Intern-Decision 2B 对照，改为 intern
VAM_SCORER_PROVIDER=local
# 仅 VAM_SCORER_PROVIDER=intern 时需要
# VAM_INTERN_URL=http://127.0.0.1:8010/score
# 清单优先级：rules=只用规则；qwen=规则优先，模糊项问 Qwen；hybrid=规则优先，模糊项问 Intern；intern=全部问 Intern
CHECKLIST_PRIORITY_PROVIDER=qwen

# 可选：DeepSeek 官方 API（OpenAI 兼容）
# 需要用 DeepSeek 时取消注释，并填入自己的 Key
# 将上方 VAM_SCORER_PROVIDER 改为 harness 后使用以下设置
# VAM_SCORER_URL=https://api.deepseek.com/v1/chat/completions
# VAM_SCORER_API_KEY=replace-with-your-key
# VAM_SCORER_MODEL=deepseek-chat
# VAM_SCORER_API_STYLE=openai

# 可选：本地 Ollama 回退模型
# VAM_SCORER_PROVIDER=local
OLLAMA_MODEL=qwen2.5:7b
# 分析阶段可单独用更快的模型；留空沿用 OLLAMA_MODEL
# ANALYZE_MODEL=qwen2.5:3b
ANALYZE_MAX_TOKENS=4000
# 分析 JSON 解析失败时重试一次
ANALYZE_RETRY=1
# Judge 可单独用更小模型；留空表示沿用 OLLAMA_MODEL
# JUDGE_MODEL=gemma3:1b
# 混合 Judge：有本地核验依据时用 7B；无核验依据时用快模型，最终仍会强制 needs_review
# JUDGE_FAST_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
# 启动时后台预热模型（1=开启）
MODEL_PRELOAD=1

# 租房合同风险审查：1=启用 Qwen 多 Agent，0=只用规则基线
RENTAL_REVIEW_USE_LLM=1

# 本地法律库未命中时，是否允许官方网页检索兜底
LEGAL_WEB_SEARCH_ENABLED=1
# bing（免 key，但可能受反爬影响）/ serpapi / tavily
LEGAL_WEB_PROVIDER=bing
# Tavily 先用 basic，失败再 advanced
TAVILY_SEARCH_DEPTH=basic
# SERPAPI_KEY=your-serpapi-key
# TAVILY_API_KEY=tvly-your-key
# Judge 只对高风险/中风险调用 LLM，低风险走确定性复核
JUDGE_SEVERITIES=high,medium
# 1=压缩 Judge 输入，0=完整证据
JUDGE_COMPACT=1
# Ollama JSON mode：要求模型只输出 JSON
OLLAMA_JSON_MODE=1
# 自动识别：规则置信度高于该值时跳过分类 LLM
AUTO_CLASSIFY_LLM_THRESHOLD=0.6
# 官方网页兜底：已知类型低风险不联网；未知类型低风险最多补 2 条
LEGAL_WEB_UNKNOWN_LOW_MAX=2
LEGAL_WEB_KNOWN_CONFIDENCE=0.6
LEGAL_WEB_WORKERS=3

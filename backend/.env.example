# ============================================================
# Contract-Scenario-Scorer 配置示例
# 复制为 backend/.env 后填入真实值；.env 已被 .gitignore 忽略
# ============================================================

# 默认评分后端：Intern-Decision 2B sidecar
VAM_SCORER_PROVIDER=intern
VAM_INTERN_URL=http://127.0.0.1:8010/score

# 可选：DeepSeek 官方 API（OpenAI 兼容）
# 需要用 DeepSeek 时取消注释，并填入自己的 Key
# VAM_SCORER_URL=https://api.deepseek.com/v1/chat/completions
# VAM_SCORER_API_KEY=replace-with-your-key
# VAM_SCORER_MODEL=deepseek-chat
# VAM_SCORER_API_STYLE=openai

# 可选：本地 Ollama 回退模型
# VAM_SCORER_PROVIDER=local
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
